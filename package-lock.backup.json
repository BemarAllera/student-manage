const express = require("express");
const sqlite3 = require("sqlite3").verbose();
const path = require("path");

const app = express();
const PORT = process.env.PORT || 3000;

const db = new sqlite3.Database(path.join(__dirname, "students.db"), error => {
  if (error) {
    console.error("Database error:", error.message);
    process.exit(1);
  }
  console.log("Connected to SQLite database.");
});

db.run(`
  CREATE TABLE IF NOT EXISTS students (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    course TEXT NOT NULL,
    year_level TEXT NOT NULL
  )
`);

// promise wrappers around the callback API
const run = (sql, params = []) =>
  new Promise((resolve, reject) => {
    db.run(sql, params, function (error) {
      if (error) return reject(error);
      resolve({ lastID: this.lastID, changes: this.changes });
    });
  });

const all = (sql, params = []) =>
  new Promise((resolve, reject) => {
    db.all(sql, params, (error, rows) => (error ? reject(error) : resolve(rows)));
  });

const YEARS = ["1st Year", "2nd Year", "3rd Year", "4th Year", "5th Year"];

function validate(body) {
  const name = String(body?.name ?? "").trim();
  const course = String(body?.course ?? "").trim();
  const year_level = String(body?.year_level ?? "");

  if (!name || !course || !YEARS.includes(year_level)) return null;
  return { name, course, year_level };
}

app.use(express.json());
app.use(express.static(path.join(__dirname, "public")));

// READ
app.get("/api/students", async (req, res, next) => {
  try {
    res.json(await all("SELECT * FROM students ORDER BY id"));
  } catch (error) {
    next(error);
  }
});

// CREATE
app.post("/api/students", async (req, res, next) => {
  try {
    const student = validate(req.body);
    if (!student) {
      return res.status(400).json({ error: "Please complete all fields correctly." });
    }

    const result = await run(
      "INSERT INTO students (name, course, year_level) VALUES (?, ?, ?)",
      [student.name, student.course, student.year_level]
    );

    res.status(201).json({ id: result.lastID, ...student });
  } catch (error) {
    next(error);
  }
});

// UPDATE
app.put("/api/students/:id", async (req, res, next) => {
  try {
    const student = validate(req.body);
    if (!student) {
      return res.status(400).json({ error: "Please complete all fields correctly." });
    }

    const result = await run(
      "UPDATE students SET name = ?, course = ?, year_level = ? WHERE id = ?",
      [student.name, student.course, student.year_level, req.params.id]
    );

    if (result.changes === 0) {
      return res.status(404).json({ error: "Student not found." });
    }

    res.json({ id: Number(req.params.id), ...student });
  } catch (error) {
    next(error);
  }
});

// DELETE
app.delete("/api/students/:id", async (req, res, next) => {
  try {
    const result = await run("DELETE FROM students WHERE id = ?", [req.params.id]);

    if (result.changes === 0) {
      return res.status(404).json({ error: "Student not found." });
    }

    res.json({ success: true });
  } catch (error) {
    next(error);
  }
});

// unknown API routes return JSON, not HTML
app.use("/api", (req, res) => {
  res.status(404).json({ error: "API route not found." });
});

// error handler (also catches bad JSON bodies)
app.use((error, req, res, next) => {
  console.error(error);
  res.status(error.status || 500).json({
    error: error.status === 400 ? "Invalid request." : "Server error."
  });
});

app.listen(PORT, () => {
  console.log(`StudentHub running at http://localhost:${PORT}`);
});